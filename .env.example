# ==========================================
# 前端配置 (Vite)
# ==========================================
# 前端 Web 绑定地址（默认 127.0.0.1，如需局域网/手机真机调试可配为 0.0.0.0）
VITE_HOST=127.0.0.1
# 前端 Web 端口
VITE_PORT=5173
# 明确指定后端代理目标端口（可选，默认自动跟随下方 PORT）
# VITE_SERVER_PORT=3000

# ==========================================
# 前端开发：GPS 模拟定位（仅开发环境使用）
# ==========================================
# 开启后定位固定为下面的坐标，便于在没有 GPS 的设备上调试「附近」模式、
# 最近站锚定与步行决策。页面顶部会显示蓝色「模拟定位」标识。
# 生产构建不设置该变量即自动关闭（Vite 在构建期内联，不会打进产物）。
# 填你所在城市任意一处坐标即可，例如：
# VITE_GPS_SIMULATION=true
# VITE_GPS_SIM_LAT=39.9042
# VITE_GPS_SIM_LNG=116.4074

# ==========================================
# 后端配置 (Fastify & Node.js)
# ==========================================
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# 数据库 (PostgreSQL 18, 容器默认暴露端口 5432)
DATABASE_URL=postgres://transit:transit_password@localhost:5432/transit

# WebSocket
WS_PATH=/ws

# 交通数据源配置
# CHELAILE_SIGN_SALT=
# CHELAILE_AES_KEY=
APIZERO_KEY=
AMAP_MAPS_API_KEY=

# 活跃线路服务端轮询间隔（秒）
TRANSIT_POLL_INTERVAL_SEC=18

# 开启模拟模式（无在途车时自动生成物理连续的模拟数据，便于开发调试与体验）
TRANSIT_SIMULATION=false
