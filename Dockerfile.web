# 实时交通 前端镜像
#
# 阶段 1：构建静态资源（vite build；类型门由 code-check 在 CI 把关，不在镜像构建时重复）
FROM node:24-slim AS build

ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable
WORKDIR /app

# 依赖清单先行，最大化层缓存
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/transit-adapter/package.json packages/transit-adapter/
COPY apps/web/package.json apps/web/
COPY apps/server/package.json apps/server/

RUN pnpm install --frozen-lockfile

# 拷入源码与共享 tsconfig（apps/web/tsconfig.{app,node}.json 经 @vue/tsconfig /
# @tsconfig/node22 + ../../tsconfig.base.json 组合继承）
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY packages/transit-adapter/ packages/transit-adapter/
COPY apps/web/ apps/web/

RUN pnpm --filter @real-time-transport/web build

# 阶段 2：nginx 提供静态资源并反代 API/WS 到后端（同源，无 CORS）
FROM nginx:alpine AS runtime

COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
