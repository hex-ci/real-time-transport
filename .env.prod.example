# 实时交通 生产环境变量模板
# 用法：cp .env.prod.example .env.prod  →  填上游 Key  →
#       docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# .env.prod 已被 gitignore，不会入库。

# ===== 数据库（compose 内部 DNS，服务名 postgres）=====
DATABASE_URL=postgres://transit:***@postgres:5432/transit
# 以下三项供 compose 创建 postgres 容器用，须与 DATABASE_URL 中的账号一致
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit_password
POSTGRES_DB=transit

# ===== 服务监听（容器内端口，勿改：nginx 反代写死 server:3000）=====
PORT=3000
HOST=0.0.0.0
WS_PATH=/ws
LOG_LEVEL=info

# ===== 交通数据源 =====
# 车来了（公交实时）。SIGN_SALT / AES_KEY 代码内已内置默认值，留空即用默认
CHELAILE_SIGN_SALT=
CHELAILE_AES_KEY=
# 极数本源（备用数据源）
APIZERO_KEY=
# 高德 Web 服务 API Key：仅服务端使用，禁止下发前端（逆地理编码 / POI 检索）
AMAP_MAPS_API_KEY=

# 活跃线路服务端轮询间隔（秒）
TRANSIT_POLL_INTERVAL_SEC=18

# 模拟模式：生产必须 false（开启会生成非真实车辆，界面会明确标注）
TRANSIT_SIMULATION=false

# ===== 前端端口（compose 变量，宿主机暴露端口）=====
WEB_PORT=8080
