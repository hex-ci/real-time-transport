{
  "name": "real-time-transport",
  "version": "0.1.0",
  "private": true,
  "description": "移动端优先实时公交与地铁可视化系统：纯粹拓扑线路、折返与直线报站屏、航位推算平滑动效",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "run-s code-check build-only",
    "build-only": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --max-warnings 0 --fix",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @real-time-transport/server test:api",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify": "run-s code-check test test:db test:api",
    "verify:full": "run-s verify test:e2e",
    "dev": "node scripts/dev.js",
    "dev:web": "pnpm --filter @real-time-transport/web dev",
    "dev:server": "pnpm --filter @real-time-transport/server dev",
    "migrate:up": "pnpm --filter @real-time-transport/server migrate:up",
    "migrate:down": "pnpm --filter @real-time-transport/server migrate:down",
    "code-check": "run-p typecheck lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
