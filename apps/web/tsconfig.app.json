{
  // The exclusion of `src/**/__tests__/*` from this project is deliberate and standing: this is the
  // app's own project, and it never type-checks test files. Tests are checked by `tsconfig.test.json`,
  // which re-includes them with the node types they need — one project per concern, so the app build
  // never reports on test fixtures.
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "../../tsconfig.base.json"],
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
